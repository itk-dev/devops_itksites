{% extends '@!EasyAdmin/layout.html.twig' %}

{% block title %}Repositories with advisories{% endblock %}

{% block content_title %}Repositories with advisories{% endblock %}

{% block main %}
    <div class="d-flex justify-content-end mb-3">
        <form method="post" action="{{ path('admin_repo_advisories_sync') }}" class="d-inline">
            <input type="hidden" name="_token" value="{{ csrf_token(csrf_intent) }}">
            <button type="submit"
                    class="btn btn-secondary action-syncAll"
                    onclick="const i=this.querySelector('i');if(i){i.classList.add('fa-spin')}this.style.pointerEvents='none';this.style.opacity='0.6'">
                <i class="fa fa-rotate"></i> Sync all
            </button>
        </form>
    </div>

    {% if rows is empty %}
        <div class="callout callout-info">No repositories have associated advisories.</div>
    {% else %}
        <table class="table datagrid">
            <thead>
                <tr>
                    <th>Repository</th>
                    <th>Project type &amp; version</th>
                    <th class="text-end">Advisories</th>
                    <th>Project</th>
                    <th>Service agreements</th>
                    <th>Code owner action</th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    {% set repo = row.repo %}
                    {% set repo_url = ea_url()
                        .unsetAll()
                        .setController('App\\Controller\\Admin\\GitRepoCrudController')
                        .setAction('detail')
                        .setEntityId(repo.id) %}
                    <tr>
                        <td><a href="{{ repo_url }}">{{ repo }}</a></td>
                        <td>
                            {% for tv in row.typesAndVersions %}
                                <span class="badge badge-secondary">{{ tv }}</span>
                            {% else %}
                                &mdash;
                            {% endfor %}
                        </td>
                        <td class="text-end">
                            {% if row.advisoriesUrl %}
                                <a href="{{ row.advisoriesUrl }}" class="text-decoration-none">
                                    <span class="badge badge-danger">{{ row.advisoryCount }}</span>
                                </a>
                            {% else %}
                                <span class="badge badge-danger">{{ row.advisoryCount }}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% for project in row.projects %}
                                {{ project.name }}{{ not loop.last ? ', ' }}
                            {% else %}
                                &mdash;
                            {% endfor %}
                        </td>
                        <td>
                            {% set contracts = [] %}
                            {% for project in row.projects %}
                                {% for sc in project.serviceAgreements %}
                                    {% set contracts = contracts|merge([sc]) %}
                                {% endfor %}
                            {% endfor %}
                            {% for sc in contracts %}
                                <div>
                                    {{ sc.hostingProvider ?? sc.economicsId }}
                                    {% if sc.validTo %}<small class="text-muted">(until {{ sc.validTo|date('Y-m-d') }})</small>{% endif %}
                                </div>
                            {% else %}
                                &mdash;
                            {% endfor %}
                        </td>
                        <td>
                            {% if row.openTicket %}
                                <div>
                                    <i class="fa fa-circle-check text-success"></i>
                                    Issue assigned to <strong>{{ row.openTicket.assigneeName ?? 'Unassigned' }}</strong>
                                    {% if row.openTicket.createdAt %}
                                        <small class="text-muted">(created {{ row.openTicket.createdAt|date('Y-m-d') }})</small>
                                    {% endif %}
                                </div>
                            {% elseif row.leantimeProjectId is null %}
                                <em class="text-muted">No Leantime project linked</em>
                            {% elseif row.codeOwners is empty %}
                                <em class="text-muted">No code owners</em>
                            {% else %}
                                <form method="post"
                                      action="{{ path('admin_repo_advisories_create_ticket', {repoId: repo.id}) }}"
                                      class="d-flex gap-2 align-items-center">
                                    <input type="hidden" name="_token" value="{{ csrf_token(csrf_intent) }}">
                                    <input type="hidden" name="leantimeProjectId" value="{{ row.leantimeProjectId }}">
                                    <select name="codeOwnerId" class="form-control form-control-sm" style="max-width: 16rem;">
                                        {% for co in row.codeOwners %}
                                            <option value="{{ co.id }}">{{ co.name }}</option>
                                        {% endfor %}
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-primary">Create ticket</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
