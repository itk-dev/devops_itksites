parameters:
    level: 6
    # Require a reason on every @phpstan-ignore so the next reader knows
    # why a check was suppressed. https://phpstan.org/user-guide/ignoring-errors#requiring-comments-for-@phpstan-ignore
    reportIgnoresWithoutComments: true
    paths:
        - bin/
        - config/
        - public/
        - src/
#        - tests/
    ignoreErrors:
        - identifier: doctrine.associationType
        - identifier: doctrine.columnType
        - identifier: method.unused
        - identifier: missingType.iterableValue
        # Doctrine collections and repositories are not annotated yet.
        # src/Controller/Admin/ is excluded on purpose: EasyAdmin CRUD
        # controllers carry @extends, and this keeps them that way.
        -
            identifier: missingType.generics
            paths:
                - src/Entity/
                - src/Repository/
                - src/Form/
                - src/Service/
                - src/Handler/
