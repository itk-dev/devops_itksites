{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "COMPOSE_USER": "deploy"
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(diff:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(gh auth status*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr list*)",
      "Bash(gh pr status*)",
      "Bash(gh pr view*)",
      "Bash(gh release list*)",
      "Bash(gh release view*)",
      "Bash(gh repo view*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(gh search*)",
      "Bash(gh workflow list*)",
      "Bash(gh workflow view*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(tail:*)",
      "Bash(task:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(docker compose exec:*)",
      "Bash(docker compose run:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose top:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose pull:*)",
      "Bash(docker compose images:*)",
      "Bash(docker network:*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -r *)",
      "Bash(rm -R*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec*)",
      "Bash(gh issue delete:*)",
      "Bash(gh release delete:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh label delete:*)",
      "Bash(gh api -X POST*)",
      "Bash(gh api -X PUT*)",
      "Bash(gh api -X PATCH*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method POST*)",
      "Bash(gh api --method PUT*)",
      "Bash(gh api --method PATCH*)",
      "Bash(gh api --method DELETE*)",
      "Bash(*.env.local*)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./config/secrets/*)"
    ],
    "ask": [
      "Bash(docker compose down:*)",
      "Bash(docker compose stop:*)",
      "Bash(docker compose rm:*)",
      "Bash(docker compose restart:*)",
      "Bash(docker compose * doctrine:database:drop*)",
      "Bash(docker compose * doctrine:schema:drop*)",
      "Bash(docker compose * hautelook:fixtures:load*)",
      "Bash(docker compose * composer fixtures*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh release create:*)",
      "Bash(gh release edit:*)",
      "Bash(gh repo create:*)",
      "Bash(gh label create:*)",
      "Bash(gh label edit:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git tag -d:*)",
      "Bash(git tag -a:*)",
      "Bash(git tag :*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git stash drop:*)",
      "Bash(git clean:*)",
      "Bash(git checkout -- :*)",
      "Bash(git restore:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "docker compose up --detach --quiet-pull 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "Starting Docker services..."
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "for c in jq intelephense; do command -v $c >/dev/null || m=\"$m $c\"; done; [ -z \"$m\" ] || { echo \"Missing on host:$m. See CLAUDE.md, Claude Code prerequisites.\" >&2; exit 2; }",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in */composer.lock|*/yarn.lock|*/symfony.lock|*/.env.local|*/.env.*.local|*/public/api-spec-v1.yaml|*/public/api-spec-v1.json|*/.claude/skills/easyadmin/*|*/.claude/skills/mate-*|*/.agents/*|*/mate/AGENT_INSTRUCTIONS.md|*/vendor/*|*/node_modules/*|*/var/*) echo 'BLOCKED: generated, locked or local-only file; change the source instead' >&2; exit 2 ;; esac"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in \"$CLAUDE_PROJECT_DIR\"/*.php) docker compose exec -T phpfpm vendor/bin/php-cs-fixer fix --quiet \"${f#\"$CLAUDE_PROJECT_DIR\"/}\" 2>/dev/null || true ;; esac",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in \"$CLAUDE_PROJECT_DIR\"/*.php) sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/phpfpm-check.sh\" vendor/bin/phpstan analyse --no-progress --error-format=raw \"${f#\"$CLAUDE_PROJECT_DIR\"/}\" ;; esac",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in \"$CLAUDE_PROJECT_DIR\"/*.twig) docker compose exec -T phpfpm vendor/bin/twig-cs-fixer lint --fix \"${f#\"$CLAUDE_PROJECT_DIR\"/}\" 2>/dev/null || true ;; esac",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in \"$CLAUDE_PROJECT_DIR\"/composer.json) docker compose exec -T phpfpm composer normalize --quiet 2>/dev/null || true ;; esac",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in \"$CLAUDE_PROJECT_DIR\"/*.js|\"$CLAUDE_PROJECT_DIR\"/*.css|\"$CLAUDE_PROJECT_DIR\"/*.scss|\"$CLAUDE_PROJECT_DIR\"/*.yaml|\"$CLAUDE_PROJECT_DIR\"/*.yml) docker compose run --rm -T prettier \"${f#\"$CLAUDE_PROJECT_DIR\"/}\" --write 2>/dev/null || true ;; esac",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in \"$CLAUDE_PROJECT_DIR\"/*.md) docker compose run --rm -T markdownlint markdownlint \"${f#\"$CLAUDE_PROJECT_DIR\"/}\" --fix 2>/dev/null || true ;; esac",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -e '.stop_hook_active' >/dev/null && exit 0; sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/phpfpm-check.sh\" bin/console lint:container",
            "timeout": 30,
            "statusMessage": "Validating Symfony DI container..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "php-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "itkdev-tools@itkdev-marketplace": true
  },
  "extraKnownMarketplaces": {
    "itksites": {
      "source": {
        "source": "github",
        "repo": "itk-dev/devops_itksites"
      }
    },
    "itkdev-marketplace": {
      "source": {
        "source": "github",
        "repo": "itk-dev/itkdev-claude-plugins"
      }
    }
  }
}
